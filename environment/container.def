# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap:docker from Rocky Linux 9 on Docker Hub.
#   Using rockylinux:9 instead of Azure Linux from MCR because MCR returns
#   JWS manifests that Apptainer's docker conveyor cannot parse.
#   Rocky Linux 9 has Python 3.11 in AppStream repos.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: docker
From: rockylinux:9
