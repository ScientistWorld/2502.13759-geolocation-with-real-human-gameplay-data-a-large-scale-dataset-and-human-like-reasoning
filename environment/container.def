# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap:docker from Rocky Linux 9 on Docker Hub.
#   Rocky Linux 9 is a RHEL-compatible distro with glibc and Python 3.11 in AppStream.
#   Using Docker Hub directly to avoid MCR JWS manifest issues.
#   Rocky Linux is small (~180MB) and should not hit rate limiting for a single pull.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: docker
From: rockylinux:9

%post
    set -e
    echo "=== Installing Python 3.11 and curl in Rocky Linux ==="
    # Use dnf (Dandified YUM) which Rocky Linux uses
    dnf install -y --setopt install_weak_deps=False python3.11 curl 2>/dev/null || true

    # Verify Python 3.11 is available
    if command -v python3.11 >/dev/null 2>&1; then
        echo "Python 3.11 found"
        python3.11 --version || python3 --version
    else
        echo "Using system Python"
        python3 --version || echo "WARNING: No python3 found"
    fi

    echo "=== Bootstrap complete ==="

    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into /dev/shm/pylib for the GPU container.
    #
    # This script runs during container build (in the Apptainer overlay).
    # All models and datasets are pre-downloaded on the login node.
    #
    # IMPORTANT: Install into SYSTEM Python (/dev/shm/pylib), not a virtual environment.
    
    set -e
    
    PYPATH="/dev/shm/pylib"
    mkdir -p "$PYPATH"
    export PYTHONPATH="$PYPATH"
    
    echo "=== Installing Python packages to $PYPATH ==="
    
    # PyTorch 2.6.0 with CUDA 12.4 (required for loading .bin model files - CVE fix)
    uv pip install --target "$PYPATH" torch==2.6.0 torchvision --index-url https://download.pytorch.org/whl/cu124 2>&1 | tail -5 || \
    uv pip install --target "$PYPATH" torch torchvision --index-url https://download.pytorch.org/whl/cu124 2>&1 | tail -5 || true
    
    # All other packages
    uv pip install --target "$PYPATH" \
        transformers>=4.40.0 \
        accelerate \
        sentencepiece \
        protobuf \
        tiktoken \
        pillow \
        opencv-python-headless \
        scipy \
        scikit-learn \
        tqdm \
        jiwer \
        rapidfuzz \
        einops \
        huggingface_hub \
        pandas \
        2>&1 | tail -5 || true
    
    echo "Python packages installed to $PYPATH"
    echo "Packages: $(ls $PYPATH | wc -l) items"
    
    echo "=== Setup Complete ==="

