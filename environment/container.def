# Apptainer definition file for GeoCoT environment.
#
# Uses Rocky Linux 9 from Docker Hub (different image namespace, less rate-limited).
# CUDA 12.5 is installed from NVIDIA's RHEL9 apt repository.
# Python packages are pre-installed to /dev/shm/pylib via setup.sh.

Bootstrap: docker
From: rockylinux:9

%post
    set -e
    cd /

    # Install wget and development tools
    dnf install -y --setopt=install_weak_deps=False \
        wget python3 python3-pip python3-devel dnf-plugins-core curl \
        && dnf clean all

    # Add NVIDIA CUDA repository for RHEL-compatible distros
    wget -q -O /etc/yum.repos.d/cuda-rhel9.repo \
        https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo
    dnf install -y --setopt=install_weak_deps=False \
        cuda-runtime-12-5 \
        && dnf clean all

    # Set environment
    echo 'export HOME=/root' >> /etc/environment
    echo 'export PYTHONUNBUFFERED=1' >> /etc/environment
    echo 'export PATH=/usr/local/cuda/bin:$PATH' >> /etc/environment
    echo 'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH' >> /etc/environment
    echo 'export CUDA_HOME=/usr/local/cuda' >> /etc/environment

%environment
    export HOME=/root
    export PYTHONUNBUFFERED=1
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export CUDA_HOME=/usr/local/cuda
    export TRANSFORMERS_CACHE=/home/user/shared/hf_cache
    export HF_HOME=/home/user/shared/hf_cache
    export PYTHONPATH=/dev/shm/pylib
