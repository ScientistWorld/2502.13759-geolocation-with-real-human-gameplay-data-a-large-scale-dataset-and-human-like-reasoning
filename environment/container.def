# Apptainer definition file for GeoCoT environment.
#
# Uses a pre-built Docker archive of Azure Linux 3.0 (created from MCR layer).
# The archive is stored locally in the workspace to avoid registry issues.
# Python packages installed via setup.sh at build time.
#
# IMPORTANT: The azurelinux_image.tar must exist in the environment directory.

Bootstrap: docker-archive
From: /home/user/environment/azurelinux_image.tar

%post
    set -e
    echo "=== Azure Linux container starting (from local archive) ==="

    # Azure Linux uses tdnf as its package manager
    tdnf install -y python3 python3-pip curl 2>/dev/null || {
        echo "tdnf install failed"
        which python3 || echo "Python3 not available"
    }

    echo "Python version: $(python3 --version 2>&1)"
    echo "pip version: $(pip3 --version 2>&1)"

    echo "=== Container bootstrap complete ==="
