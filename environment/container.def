# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Rocky Linux 9 base OS via Bootstrap:yum.
#   Uses download.rockylinux.org as the base URL.
#   No %post section = no device creation = no fakeroot issues.
# RUNTIME: Job script installs Python + CUDA + packages on compute node.

Bootstrap: yum
From: rockylinux:9

%setup
    # Create custom yum repo config pointing to accessible mirror
    # This runs on the host before %post, with host's yum
    cat > /tmp/rocky9.repo << 'EOF'
[rocky9-baseos]
name=Rocky Linux 9 - BaseOS
baseurl=https://download.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/
gpgcheck=0
enabled=1

[rocky9-appstream]
name=Rocky Linux 9 - AppStream
baseurl=https://download.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/
gpgcheck=0
enabled=1
EOF
