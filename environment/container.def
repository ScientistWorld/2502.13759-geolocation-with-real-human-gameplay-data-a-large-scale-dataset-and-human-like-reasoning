# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap:localimage from pre-downloaded Azure Linux tar.
#   The azurelinux.tar is a valid Docker image created from MCR blobs.
#   Using localimage avoids registry issues (JWS from MCR, rate limits from Docker Hub).
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: localimage
From: /home/user/environment/azurelinux.tar
