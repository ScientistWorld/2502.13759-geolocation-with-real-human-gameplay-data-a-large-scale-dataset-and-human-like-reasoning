# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Uses pre-downloaded Red Hat UBI 8.10 tar on GPFS at
#   /tmp/claude-code-tmp/ubi8-ubi.tar (same on build and compute nodes).
#   Bootstrap:localimage bypasses ALL registry fetching.
#   Empty %post = no device creation = no nodev/fakeroot issues.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: localimage
From: /tmp/claude-code-tmp/ubi8-ubi.tar
