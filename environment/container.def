# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap: localimage from pre-built rootfs
#   Uses existing rootfs from shared/container/rootfs
#   Avoids network/registry issues entirely by using local filesystem.
# RUNTIME: Job script installs Python 3.11 and CUDA on compute node.
#
# FIX: Previous builds failed with:
# 1. TLS handshake on library://apptainer/singularity-ce:9.3-6
# 2. "invalid yum header" with Bootstrap: yum on rockylinux:9

Bootstrap: localimage
From: /home/user/shared/container/rootfs.tar.gz

%post
    set -e
    echo "=== Using pre-built rootfs from shared/container ==="
    echo "Python 3.11 should be installed in rootfs"

    # Verify Python3.11 is available
    if command -v python3.11 >/dev/null 2>&1; then
        echo "Python3.11 found"
        python3.11 --version
    elif command -v python3 >/dev/null 2>&1; then
        echo "Python3 found"
        python3 --version
    else
        echo "WARNING: No python3 found"
    fi

    echo "=== Bootstrap complete ==="
