# Apptainer definition file for GeoCoT environment.
#
# Minimal container definition - relies on runtime package installation
# in the job script (/dev/shm/pylib)
#
# FIX: Previous builds failed with network/registry issues.
# Simplified to use Bootstrap: yum with Rocky Linux 9.

Bootstrap: yum
From: rockylinux:9

%post
    set -e

    # Install Python 3.11
    yum install -y python3.11 python3.11-pip python3.11-devel curl wget 2>/dev/null || true

    # Verify Python3.11 is available
    if command -v python3.11 >/dev/null 2>&1; then
        echo "Python3.11 found"
        python3.11 --version
    else
        echo "ERROR: Python3.11 not found"
        exit 1
    fi

    echo "=== Bootstrap complete ==="
