# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap:docker from Red Hat UBI 8 on Docker Hub.
#   Uses pre-downloaded UBI 8 tar from /tmp/claude-code-tmp/
#   as local cache for Docker Hub image.
# RUNTIME: Job script installs Python + packages on compute node.

Bootstrap: docker
From: registry.access.redhat.com/ubi8/ubi:latest

%post
    set -e
    echo "=== Bootstrap complete ==="
