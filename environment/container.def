# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap:docker from Rocky Linux 9 on Docker Hub.
#   Rocky Linux 9 is a RHEL-compatible distro with glibc and Python 3.11 in AppStream.
#   Using Docker Hub directly to avoid MCR JWS manifest issues.
#   Rocky Linux is small (~180MB) and should not hit rate limiting for a single pull.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: docker
From: rockylinux:9

%post
    set -e
    echo "=== Installing Python 3.11 and curl in Rocky Linux ==="
    # Use dnf (Dandified YUM) which Rocky Linux uses
    dnf install -y --setopt install_weak_deps=False python3.11 curl 2>/dev/null || true

    # Verify Python 3.11 is available
    if command -v python3.11 >/dev/null 2>&1; then
        echo "Python 3.11 found"
        python3.11 --version || python3 --version
    else
        echo "Using system Python"
        python3 --version || echo "WARNING: No python3 found"
    fi

    echo "=== Bootstrap complete ==="
