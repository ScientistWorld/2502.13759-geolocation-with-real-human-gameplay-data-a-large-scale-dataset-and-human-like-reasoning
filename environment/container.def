# Apptainer definition file for GeoCoT environment.
#
# Uses Ubuntu 22.04 as base image (getopt is available, fakeroot works).
# Python packages are installed via setup.sh at build time.
#
# IMPORTANT: Build requires internet access (Docker Hub).
# Compute nodes have NO internet — all models/data must be pre-downloaded.

Bootstrap: docker
From: ubuntu:22.04

%post
    set -e
    echo "=== Ubuntu 22.04 container starting ==="

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y python3 python3-pip curl wget git

    echo "Python version: $(python3 --version 2>&1)"
    echo "=== Container bootstrap complete ==="