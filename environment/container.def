# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Red Hat UBI 8 from registry.access.redhat.com.
#   registry.access.redhat.com verified HTTP 200 — not rate-limited.
#   Using specific tag :8.10 (avoids tag manifest resolution).
#   Empty %post = no device creation = no nodev/fakeroot issues.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: docker
From: registry.access.redhat.com/ubi8/ubi:8.10
