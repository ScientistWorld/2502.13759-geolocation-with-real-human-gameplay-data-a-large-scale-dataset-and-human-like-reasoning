# Apptainer definition file for GeoCoT environment.
#
# Build:  apptainer build container.sif container.def
#
# This container provides GPU support for running GeoCoT with local VLMs.
# The workspace is bind-mounted at /home/user at runtime.

Bootstrap: docker
From: nvidia/cuda:12.1.0-runtime-ubuntu22.04

%files
    # No files needed — workspace is bind-mounted

%post
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        libomp-dev libgl1-mesa-glx libglib2.0-0 \
        tmux nano vim-tiny less curl wget git git-lfs \
        libjpeg-dev zlib1g-dev libpng-dev \
        && ln -sf /usr/bin/vim.tiny /usr/bin/vim \
        && rm -rf /var/lib/apt/lists/*

    # Create user directory
    mkdir -p /home/user
    chmod 755 /home/user

    # Set environment
    echo 'export HOME=/home/user' >> /etc/environment
    echo 'export PYTHONUNBUFFERED=1' >> /etc/environment

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export TRANSFORMERS_CACHE=/home/user/shared/hf_cache
    export HF_HOME=/home/user/shared/hf_cache
