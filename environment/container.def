# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap: yum from Rocky Linux 9 minimal image
#   Uses standard base image without Docker Hub dependency
#   RUNTIME: Job script installs Python 3.11 and CUDA on compute node.
#
# FIX: Previous build failed with TLS handshake on library://apptainer/singularity-ce:9.3-6
# Switched to Bootstrap: yum to use standard CentOS/Rocky base image.

Bootstrap: yum
From: rockylinux:9

%post
    set -e
    echo "=== Installing Python 3.11 and curl in Rocky Linux 9 ==="

    # Install Python 3.11, pip, and curl
    yum install -y python3.11 python3.11-pip python3.11-devel curl wget 2>/dev/null || true

    # Verify Python3.11 is available
    if command -v python3.11 >/dev/null 2>&1; then
        echo "Python3.11 found"
        python3.11 --version
    else
        echo "ERROR: Python3.11 not found"
        exit 1
    fi

    echo "=== Bootstrap complete ==="
