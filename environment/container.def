# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Pre-built Azure Linux 3.0 tar in workspace.
#   Image layer downloaded from mcr.microsoft.com (HTTP 200, no rate limits).
#   Bootstrap:localimage bypasses registry fetching entirely.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: localimage
From: /home/user/environment/azurelinux.tar
