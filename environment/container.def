# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Symlink in FUSE /tmp (tmpfs) pointing to GPFS tar.
#   Symlink: /tmp/ubi8-ubi.tar -> /home/user/shared/container/images/ubi8-ubi.tar
#   /tmp is the 64MB tmpfs on FUSE root, accessible during Apptainer build.
#   /home/user is the GPFS mount, accessible during Apptainer build.
#   Bootstrap:localimage reads the tar via the symlink.
#   Empty %post = no device creation = no nodev/fakeroot issues.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: localimage
From: /tmp/ubi8-ubi.tar
