# Apptainer definition file for GeoCoT environment.
#
# Uses Ubuntu 22.04 as base image. Python packages installed via setup.sh.
# CUDA runtime is provided by the host (compute nodes have GPUs).
#
# IMPORTANT: Build requires internet access (Docker Hub + PyPI).
# Runtime on compute nodes requires NO internet.

Bootstrap: docker
From: ubuntu:22.04

%post
    set -e
    echo "=== Ubuntu 22.04 container starting ==="

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y python3 python3-pip curl wget git

    echo "=== Container bootstrap complete ==="
