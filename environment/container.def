# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Uses pre-downloaded Red Hat UBI 8.10 tar file from shared GPFS.
#   Image blobs were manually downloaded from registry.access.redhat.com
#   to /home/user/shared/container/images/ubi8-ubi.tar.
#   Bootstrap:localimage completely bypasses registry fetching.
#   Empty %post = no device creation = no nodev/fakeroot issues.
# RUNTIME: Job script installs Python + CUDA on compute node.

Bootstrap: localimage
From: /home/user/shared/container/images/ubi8-ubi.tar
