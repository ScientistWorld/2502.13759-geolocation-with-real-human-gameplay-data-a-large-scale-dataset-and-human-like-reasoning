# Apptainer definition file for GeoCoT environment.
#
# BUILDTIME: Bootstrap:docker with Alpine + MCR blob download.
#   MCR returns JWS for manifest requests which Apptainer docker conveyor cannot parse.
#   This approach uses Bootstrap:docker with tiny Alpine (no rate limits) to get a
#   shell environment, then downloads the Azure Linux rootfs layer directly via curl
#   in %post, sidestepping the docker conveyor entirely.
# RUNTIME: Job script installs Python + packages on compute node.

Bootstrap: docker
From: alpine:3

%post
    set -e
    echo "=== Installing curl in Alpine ==="
    apk add --no-cache curl tar

    echo "=== Downloading Azure Linux rootfs from MCR ==="
    LAYER_BLOB="sha256:5546a28a785aeec63c8bd58a7dafb93b463e13f23d4fd7582a86d73722a6fb33"
    curl -sL -o /tmp/azurelinux-layer.tar \
        "https://mcr.microsoft.com/v2/azurelinux/base/core/blobs/${LAYER_BLOB}" \
        --connect-timeout 60 --max-time 600 || {
        echo "FAILED to download Azure Linux layer"
        cat /tmp/azurelinux-layer.tar 2>/dev/null | head -5
        exit 1
    }

    echo "=== Extracting Azure Linux rootfs ==="
    mkdir -p /tmp/azlinux
    tar -xf /tmp/azurelinux-layer.tar -C /tmp/azlinux || {
        echo "FAILED to extract layer tar"
        exit 1
    }
    rm /tmp/azurelinux-layer.tar

    echo "=== Layering Azure Linux over Alpine base ==="
    cp -a /tmp/azlinux/* / || true
    rm -rf /tmp/azlinux

    echo "=== Bootstrap complete ==="

    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into /dev/shm/pylib for the GPU container.
    #
    # This script runs during container build (in the Apptainer overlay).
    # All models and datasets are pre-downloaded on the login node.
    #
    # IMPORTANT: Install into SYSTEM Python (/dev/shm/pylib), not a virtual environment.
    
    set -e
    
    PYPATH="/dev/shm/pylib"
    mkdir -p "$PYPATH"
    export PYTHONPATH="$PYPATH"
    
    echo "=== Installing Python packages to $PYPATH ==="
    
    # PyTorch 2.6.0 with CUDA 12.4 (required for loading .bin model files - CVE fix)
    uv pip install --target "$PYPATH" torch==2.6.0 torchvision --index-url https://download.pytorch.org/whl/cu124 2>&1 | tail -5 || \
    uv pip install --target "$PYPATH" torch torchvision --index-url https://download.pytorch.org/whl/cu124 2>&1 | tail -5 || true
    
    # All other packages
    uv pip install --target "$PYPATH" \
        transformers>=4.40.0 \
        accelerate \
        sentencepiece \
        protobuf \
        tiktoken \
        pillow \
        opencv-python-headless \
        scipy \
        scikit-learn \
        tqdm \
        jiwer \
        rapidfuzz \
        einops \
        huggingface_hub \
        pandas \
        2>&1 | tail -5 || true
    
    echo "Python packages installed to $PYPATH"
    echo "Packages: $(ls $PYPATH | wc -l) items"
    
    echo "=== Setup Complete ==="

